/dts-v1/;
#include <nordic/nrf52833_qdaa.dtsi>
#include <zephyr/dt-bindings/led/led.h>
#include <dt-bindings/regulator/npm13xx.h>
#include "nRF52833_tag-pinctrl.dtsi"

/ {
	model = "LP custom tag";
	compatible = "Innovaforce,nRF52833-tag";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		led0 = &status_led;
		led-strip = &ws2812;
		button0 = &user_button;
	};


	leds {
		compatible = "gpio-leds";
		status_led: led_0 {
			gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
		};
	};

	buttons {
		compatible = "gpio-keys";
		user_button: button_0 {
			gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
			label = "Button 0";
		};
		accel_int: accel_int_0 {
			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
			label = "Accel INT1";
		};
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(48)>;
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000c000 DT_SIZE_K(220)>;
		};

		slot1_partition: partition@43000 {
			label = "image-1";
			reg = <0x00043000 DT_SIZE_K(220)>;
		};

		storage_partition: partition@7a000 {
			label = "storage";
			reg = <0x0007a000 DT_SIZE_K(24)>;
		};
	};
};

&nfct {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
	/* Suspend TWIM0 between transactions (battery sampler, accelerometer
	 * register writes). The driver already brackets every transfer with
	 * pm_device_runtime_get/put; this is what enables it. */
	zephyr,pm-device-runtime-auto;

	/* nPM1304 PMIC. No GPIO lines are wired between the nPM1304 and the
	 * nRF52833, so no host-int-gpios / pmic-int-pin properties are set;
	 * the charger is read by polling only. */
	npm1304_pmic: pmic@6b {
		compatible = "nordic,npm1304";
		reg = <0x6b>;

		regulators {
			compatible = "nordic,npm1304-regulator";

			BUCK1 {
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1600000>;
				regulator-boot-on;
			};

			BUCK2 {
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
			};

			LDO1 {
				regulator-min-microvolt = <2500000>;
				regulator-max-microvolt = <2500000>;
				regulator-initial-mode = <NPM13XX_LDSW_MODE_LDO>;
				regulator-boot-on;
			};

			LDO2 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-initial-mode = <NPM13XX_LDSW_MODE_LDO>;
				regulator-boot-on;
			};
		};

		/* LED0 drives the charge-status LED on the board. In "charging"
		 * mode the PMIC lights it itself from the charger block, so no
		 * firmware, thread or I2C polling is involved. LED1 and LED2 are
		 * not wired, but the binding requires all three modes; "host"
		 * leaves them software-controlled and dark. */
		npm1304_leds: leds {
			compatible = "nordic,npm1304-led";
			nordic,led0-mode = "charging";
			nordic,led1-mode = "host";
			nordic,led2-mode = "host";
		};

		/* 100 mA into the 400 mAh cell is 0.25C. Revisit current-microamp
		 * when the cell changes.
		 *
		 * thermistor-ohms = 0 disables the NTC because the pad is not
		 * exposed on this PCB, so the PMIC cannot read cell temperature
		 * and charging runs with no thermal cutoff. That is a hardware
		 * constraint, not a missing setting — do not "fix" it here.
		 *
		 * charging-enable is what actually switches the charger on;
		 * without it the block is configured but idle and the battery
		 * current reads 0 mA with VBUS connected. */
		npm1304_charger: charger {
			compatible = "nordic,npm1304-charger";
			charging-enable;
			term-microvolt = <4200000>;
			current-microamp = <100000>;
			vbus-limit-microamp = <500000>;
			thermistor-ohms = <0>;
			thermistor-beta = <0>;
		};
	};
};

&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
};

&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";
	/* Suspend SPIM3 except during a WS2812 write. The LED is dark in normal
	 * operation, so this bus is idle essentially all the time.
	 * Deliberately NOT applied to &spi1 -- the DW3000 path runs from the
	 * GPIO ISR and must not take suspend/resume there. */
	zephyr,pm-device-runtime-auto;

	ws2812: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		spi-max-frequency = <4000000>;
		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
	};
};

